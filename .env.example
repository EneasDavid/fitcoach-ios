# FitCoach — variables for building, shipping and the security pipeline.
# Copy to `.env` (git-ignored) and fill in. NEVER commit the real file, and never paste its values into an issue or a chat.
# scripts/testflight.sh loads `.env` automatically when it exists.
#
# DATABASE: no Firebase project (so no database) is configured in this repository. Without the values below the app runs in DEMO MODE
# with in-memory data (launch argument -UITestMode). To use a real database see README → "Configuração do banco de dados (Firebase)".

# --- Apple (TestFlight) — needs a paid Apple Developer Program account ---
DEVELOPMENT_TEAM=            # 10-character Team ID (developer.apple.com → Account → Membership)
ASC_KEY_ID=                  # App Store Connect API key id
ASC_ISSUER_ID=               # App Store Connect issuer id
ASC_KEY_PATH=                # path to AuthKey_XXXX.p8 on THIS machine (the file itself is git-ignored)

# --- App build settings (public identifiers, injected into Info.plist; empty = that integration is off) ---
BACKEND_BASE_URL=            # https://southamerica-east1-<your-project>.cloudfunctions.net  (empty = first access / password reset are off)
SPOTIFY_CLIENT_ID=
FACEBOOK_APP_ID=

# --- Security pipeline (GitHub repository *secret*, listed here for completeness) ---
NVD_API_KEY=                 # free key from nvd.nist.gov/developers/request-an-api-key (enables OWASP Dependency-Check)
