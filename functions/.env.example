# Cloud Functions parameters (non-secret). Copy to `functions/.env` (git-ignored) or `functions/.env.<project-id>`; `firebase deploy` reads it.
# SECRETS never go in a file: set them with  firebase functions:secrets:set <NAME>  (REGISTRATION_SECRET, STRAVA_CLIENT_SECRET,
# STRAVA_VERIFY_TOKEN, PLACES_API_KEY).
STRAVA_CLIENT_ID=
STRAVA_SUBSCRIPTION_ID=
# e.g. https://southamerica-east1-<your-project>.cloudfunctions.net
PUBLIC_FUNCTIONS_URL=
